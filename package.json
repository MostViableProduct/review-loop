{
  "name": "review-loop",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Enforced Codex adversarial review inside Claude Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MostViableProduct/review-loop.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "review-loop": "cli/review-loop.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=${TEST_CONCURRENCY:-4} 'test/**/*.test.mjs'",
    "sabotage": "node scripts/sabotage.mjs",
    "docs:check": "node scripts/gen-readme-tables.mjs --check",
    "content-gate": "node scripts/content-gate.mjs",
    "e2e": "REVIEW_LOOP_E2E=1 node --test test/e2e/live.test.mjs"
  }
}
